# Las variables del circuito comercial: cobrar, emitir la licencia, mandarla,
# entregar el instalador y abrir el panel. Este archivo es una plantilla:
# NO contiene ningún valor, sólo los nombres y de dónde sale cada uno.
#
# Dónde se cargan de verdad:
#   · el sitio  → Vercel → Project → Settings → Environment Variables (Production)
#   · el build  → GitHub → Settings → Secrets and variables → Actions
#
# Nunca acá. Este archivo se versiona; un valor pegado adentro queda en el
# historial del repositorio para siempre, aunque después se borre.
#
# Qué falta y qué anda, en vivo: GET /api/estado (con ?probar=1 usa cada
# credencial contra su servicio en vez de mirar si está definida).
# Explicación paso a paso de cada una: docs/PRODUCCION.md

# El sello con el que se firman las licencias. Se genera en /claves, dentro de
# tu navegador. Quien lo tenga puede regalar el producto.
MV_LICENSE_PRIVATE_KEY=

# El lector de ese sello. Sale del mismo botón, va adentro de cada instalador.
# No es secreta.
MV_LICENSE_PUBLIC_KEY=

# MercadoPago → Desarrolladores → tu aplicación → Credenciales. Empezá con las
# de prueba y pasá a producción recién después de una compra de ensayo.
MP_ACCESS_TOKEN=

# GitHub → Developer settings → Fine-grained token → sólo este repositorio,
# permiso Contents: Read-only. Nada más.
GITHUB_TOKEN=

# La contraseña del panel de ventas. La inventás vos: una frase larga que no
# uses en otro lado. Quien entre puede emitir licencias gratis.
PANEL_CLAVE=

# resend.com → API Keys → Create API Key (Sending access). Manda la licencia al
# que compra y te avisa de los pedidos de demo.
RESEND_API_KEY=

# El remitente de esos correos. Para que no caigan en spam, verificá el dominio
# en resend.com/domains
CORREO_DESDE=

# Dónde te llegan los pedidos de demo.
CORREO_AVISOS=

# La URL pública del sitio, con https y sin barra final. Con esto se arman los
# enlaces de descarga que van en el correo.
SITIO=

# ── opcionales ───────────────────────────────────────────────────────────────
# "usuario/repositorio" de donde salen el instalador y las descargas contadas.
REPO=
# Nombre del .exe que se entrega a quien compró, y el de la compilación owner.
ARCHIVO_INSTALADOR=
ARCHIVO_INSTALADOR_OWNER=

# ── el programa de escritorio (no el sitio) ──────────────────────────────────
# Token de la API local, carpeta de datos, orígenes permitidos y días de prueba.
MV_API_TOKEN=
MV_DATA_DIR=
MV_CORS_ORIGINS=
MV_DEMO_DIAS=
