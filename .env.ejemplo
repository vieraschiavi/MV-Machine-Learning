# Copiá este archivo a `.env` y completá los valores. El `.env` NO se versiona:
# lleva la credencial de acceso y la licencia.
#
#     cp .env.ejemplo .env

# ── Credencial de acceso ─────────────────────────────────────────────────────
# La que se escribe en la pantalla de acceso del navegador. Sin ella el
# programa no arranca. Generala con:
#     openssl rand -base64 32
MV_API_TOKEN=

# ── Licencia ─────────────────────────────────────────────────────────────────
# La licencia owner y la clave pública que la valida. Se emiten desde el panel
# del sitio (sección «Emitir licencia», nivel Owner, sin vencimiento).
# Van por entorno a propósito: así no queda un archivo de licencia en el disco
# del cliente cuando el proyecto termine.
MV_LICENSE=
MV_LICENSE_PUBLIC_KEY=

# ── Red ──────────────────────────────────────────────────────────────────────
# Por omisión escucha sólo en el propio servidor, y se llega por túnel SSH:
#     ssh -L 8000:127.0.0.1:8000 usuario@servidor
# Para exponerlo en la red de la empresa —sólo detrás de HTTPS y con el visto
# bueno del cliente— poné 0.0.0.0.
MV_BIND=127.0.0.1
MV_PUERTO=8000
MV_CORS_ORIGINS=http://localhost:8000

# ── Dónde quedan los datos ───────────────────────────────────────────────────
# Carpeta del servidor donde viven datasets, modelos e informes. Es lo único
# que persiste: lo que hay que respaldar, y lo que hay que borrar al terminar.
MV_DATOS=./datos-servidor

# ── Recursos ─────────────────────────────────────────────────────────────────
MV_CPUS=4
MV_RAM=8g
